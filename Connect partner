<script>
  const SUPABASE_URL = 'https://ohfiavubhiwvnffqqjiu.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_TCILF7kHjN2mvVpHZbrJCw_Jz5LTHij';
  const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
  const TABLE_NAME = 'registrations';
  const SELFIE_BUCKET = 'selfies';
  const RAZORPAY_KEY = "rzp_test_Td9s69Mi9dBnMx";

  let selfieFile = null;
  let cameraStream = null;

  function showScreen(id){
    ['landing','profileForm','thanks','cameraModal'].forEach(s => {
      const el = document.getElementById(s);
      if(el) el.classList.add('hidden');
    });
    document.getElementById(id).classList.remove('hidden');
    window.scrollTo(0,0);
  }

  function startPayment(){
    new Razorpay({
      key: RAZORPAY_KEY,
      amount: 39900,
      currency: "INR",
      name: "Connect Partner",
      description: "One-time Access Fee",
      handler: function(response){
        localStorage.setItem('cc_payment_id', response.razorpay_payment_id);
        showScreen('profileForm');
      },
      theme: { color: "#ffd700" }
    }).open();
  }

  function openCamera(){
    showScreen('cameraModal');
    navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false })
      .then(stream => {
        cameraStream = stream;
        document.getElementById('cameraVideo').srcObject = stream;
      })
      .catch(() => {
        alert('Camera not available. Please upload a photo.');
        closeCamera();
      });
  }

  function closeCamera(){
    if(cameraStream){ cameraStream.getTracks().forEach(t => t.stop()); cameraStream = null; }
    showScreen('profileForm');
  }

  function captureSelfie(){
    const video = document.getElementById('cameraVideo');
    const canvas = document.getElementById('cameraCanvas');
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0);
    canvas.toBlob(blob => {
      selfieFile = new File([blob], 'selfie_' + Date.now() + '.jpg', { type: 'image/jpeg' });
      document.getElementById('selfiePreview').src = URL.createObjectURL(blob);
      document.getElementById('selfiePreview').style.display = 'block';
      document.getElementById('selfieText').textContent = 'Selfie captured ✓';
      closeCamera();
    }, 'image/jpeg', 0.85);
  }

  document.getElementById('selfieInput').addEventListener('change', function(e){
    const file = e.target.files[0];
    if(file){
      selfieFile = file;
      document.getElementById('selfiePreview').src = URL.createObjectURL(file);
      document.getElementById('selfiePreview').style.display = 'block';
      document.getElementById('selfieText').textContent = 'Photo selected ✓';
    }
  });

  document.getElementById('dataForm').addEventListener('submit', async function(e){
    e.preventDefault();
    const errEl = document.getElementById('formError');
    errEl.style.display = 'none';
    if(!selfieFile){
      errEl.textContent = 'Please take or upload a selfie.';
      errEl.style.display = 'block';
      return;
    }
    const btn = document.getElementById('submitBtn');
    btn.textContent = 'Submitting...';
    btn.disabled = true;

    try {
      let selfieUrl = null;
      try {
        const fileName = 'selfie_' + Date.now() + '_' + Math.random().toString(36).slice(2,8) + '.jpg';
        const { data: up, error: upErr } = await supabaseClient.storage.from(SELFIE_BUCKET).upload(fileName, selfieFile, { contentType: 'image/jpeg' });
        if(!upErr && up){
          selfieUrl = supabaseClient.storage.from(SELFIE_BUCKET).getPublicUrl(fileName).data.publicUrl;
        }
      } catch(e){ console.warn('Storage:', e); }

      const row = {
        name: document.getElementById('name').value.trim(),
        age: parseInt(document.getElementById('age').value, 10) || null,
        gender: document.getElementById('gender').value,
        looking: document.getElementById('looking').value,
        city: document.getElementById('city').value.trim(),
        qualification: document.getElementById('qualification').value.trim() || null,
        languages: document.getElementById('languages').value.trim() || null,
        payment_id: localStorage.getItem('cc_payment_id') || null,
        selfie_url: selfieUrl,
        created_at: new Date().toISOString()
      };

      const { error } = await supabaseClient.from(TABLE_NAME).insert([row]);
      if(error){
        errEl.textContent = 'Could not save. Try again.';
        errEl.style.display = 'block';
        btn.textContent = 'Submit & Activate';
        btn.disabled = false;
        console.error(error);
        return;
      }
      showScreen('thanks');
    } catch(err){
      errEl.textContent = 'Something went wrong. Try again.';
      errEl.style.display = 'block';
      btn.textContent = 'Submit & Activate';
      btn.disabled = false;
    }
  });

  const profiles = [
    {n:"Anjali S.",a:29,g:"Female",s:"online",img:"https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200&h=200&fit=crop&crop=face"},
    {n:"Rahul M.",a:31,g:"Male",s:"available",img:"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=200&fit=crop&crop=face"},
    {n:"Priya K.",a:27,g:"Female",s:"busy",img:"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&h=200&fit=crop&crop=face"},
    {n:"Amit D.",a:34,g:"Male",s:"online",img:"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop&crop=face"},
    {n:"Neha R.",a:28,g:"Female",s:"booked",img:"https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=200&h=200&fit=crop&crop=face"},
    {n:"Vikram T.",a:36,g:"Male",s:"busy",img:"https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=200&h=200&fit=crop&crop=face"},
    {n:"Pooja G.",a:30,g:"Female",s:"available",img:"https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200&h=200&fit=crop&crop=face"},
    {n:"Suresh J.",a:33,g:"Male",s:"online",img:"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=200&h=200&fit=crop&crop=face"}
  ];
  const tickerList = [
    "Someone from Indore just unlocked access",
    "A member from Lucknow is browsing now",
    "Profile from Jaipur got booked 12 min ago",
    "New member joined from Kanpur",
    "Someone is online from Bhopal right now",
    "Slot taken by user from Patna",
    "Nagpur member just completed payment",
    "Surat user is looking for company tonight",
    "Raipur member unlocked access",
    "Agra user submitted profile",
    "Someone from Ranchi is free this evening",
    "Gwalior member just joined"
  ];

  function renderProfiles(){
    const list = [...profiles].sort(()=>Math.random()-0.5).slice(0,6);
    document.getElementById('profileGrid').innerHTML = list.map(p=>{
      const st = p.s==='online'?'● Online':p.s==='available'?'Available':p.s==='busy'?'Busy':'Booked';
      return `<div class="card"><div class="status ${p.s}">${st}</div><div class="avatar"><img src="${p.img}"></div><h4>${p.n}</h4><div class="meta">${p.a} • ${p.g}</div></div>`;
    }).join('');
  }
  function renderTicker(){
    document.getElementById('ticker').innerHTML = [...tickerList,...tickerList].map(t=>`<span>${t}</span>`).join('');
  }

  let slots=17, users=1642, joined=368, online=74, live=37;
  setInterval(()=>{ if(Math.random()>0.5){ live=Math.min(52,live+1); document.getElementById('live').textContent=live; }},12000);
  setInterval(()=>{ if(Math.random()>0.55){ joined++; users++; document.getElementById('statJoined').textContent=joined; document.getElementById('statUsers').textContent=users.toLocaleString(); }},17000);
  setInterval(()=>{ online=Math.max(42,Math.min(85,online+(Math.random()>0.5?1:-1))); document.getElementById('statOnline').textContent=online; },9000);
  setInterval(()=>{ if(Math.random()>0.55 && slots>5){ slots--; document.getElementById('slots').textContent=slots; }},14000);
  setInterval(renderProfiles, 18000);

  renderProfiles();
  renderTicker();
</script>
</body>
</html>
